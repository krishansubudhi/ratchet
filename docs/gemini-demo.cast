[18.8009, "o", "granted +29 to source (57 -> 86), logged in .ratchet-grants.jsonl\r\ncommit .ratchet.json and .ratchet-grants.jsonl together\r\n"]
[18.8109, "o", "\r\n"]
[18.8131, "o", "\u001b[1;35mhuman$\u001b[0m ratchet grant +11 --group tests --reason \"tests for per-category budgets\"\r\n"]
